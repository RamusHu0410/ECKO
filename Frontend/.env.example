# Frontend settings. Copy to `.env` (git-ignored) and fill in. Only VITE_ variables reach the browser,
# so never put secrets here: these values are public by design.

# Auth0 (used by the /auth-test page). From Auth0 Dashboard > Applications > your SPA > Settings.
VITE_AUTH0_DOMAIN=dev-xxxxxxxx.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
# Must equal AUTH0_API_AUDIENCE in backend/.env (the API's Identifier in Auth0 Dashboard > APIs).
VITE_AUTH0_AUDIENCE=https://api.melodyrecorder.com
