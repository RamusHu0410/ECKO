# ------------------------------------------------------------------
# ECKO backend environment. Copy to `.env` and fill in real values.
# NEVER commit the real .env file.
# ------------------------------------------------------------------

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# --- TigerData / Tiger Cloud (PostgreSQL) -------------------------
# Copy the connection string from your Tiger Cloud service.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# The app auto-rewrites this to the psycopg driver internally.
DATABASE_URL=postgres://tsdbadmin:t0j03djc0aocd1sp@v3pzhm175c.yd73b05qpc.tsdb.cloud.timescale.com:34085/tsdb?sslmode=require

# Optional separate database for running tests (falls back to in-memory sqlite).
# TEST_DATABASE_URL=postgresql://.../ecko_test?sslmode=require

# --- Auth0 (identity provider) ------------------------------------
# From your Auth0 tenant. AUTH0_DOMAIN is the tenant domain (no https://).
# AUTH0_API_AUDIENCE is the "Identifier" of the API you created in Auth0.
AUTH0_DOMAIN=dev-q0zwekwdrnof1sar.us.auth0.com
AUTH0_API_AUDIENCE=https://dev-q0zwekwdrnof1sar.us.auth0.com/api/v2/


# Where generated MIDI/WAV recordings are stored on disk.
RECORDINGS_FOLDER=./recordings
