.env
.aider

# Python bytecode caches — regenerated on every run, never worth tracking
__pycache__/
*.pyc

# Local virtualenvs
.venv/

# Audio: hums, uploads, recordings and rendered songs are made at runtime, never tracked.
# The tests' own fixture clips are the exception.
*.wav
!**/tests/fixtures/*.wav

# Users' saved recordings (backend/src/app/storage.py): user data, never tracked.
backend/storage/
